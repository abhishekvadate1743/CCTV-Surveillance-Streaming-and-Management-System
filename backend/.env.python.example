# Python Services Environment Variables

# Flask Server
FLASK_APP=services/stream_service.py
FLASK_ENV=development
FLASK_PORT=5001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cctv-surveillance
MONGODB_DB=cctv-surveillance

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Video Streaming
STREAM_PORT=8080
HLS_SEGMENT_DURATION=10
HLS_PLAYLIST_SIZE=5
VIDEO_BITRATE=2000k
VIDEO_QUALITY_VARIANTS=480p,720p,1080p

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
FFMPEG_THREADS=4

# AI/ML Models
MODEL_PERSON_DETECTION=yolov8n.pt
MODEL_VEHICLE_DETECTION=yolov8n.pt
MODEL_PERSON_REID=osnet_x0_25.pt
CONFIDENCE_THRESHOLD=0.5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/python_services.log

# Celery (Task Queue)
CELERY_BROKER=redis://localhost:6379/0
CELERY_BACKEND=redis://localhost:6379/1

# Socket.IO
SOCKETIO_ASYNC_MODE=threading
SOCKETIO_CORS_ALLOWED_ORIGINS=*

# Email Notifications (Optional)
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# API Keys
BACKEND_API_URL=http://localhost:5000/api
BACKEND_API_KEY=your_api_key_here
